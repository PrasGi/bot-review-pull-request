# Dependencies and build output — rebuilt inside the image
node_modules
.next
out
build
coverage

# VCS and local tooling
.git
.gitignore
.claude
.sisyphus
.claude-compact-state.md

# Secrets — injected at runtime via env_file, never baked into the image
.env
.env.*
secrets

# PaaS config, not used on self-hosted Docker
.vercel
vercel.json

# Local-only scripts (tsx CLI helpers, not part of the server runtime)
scripts

# Docs and tests — not needed to build or run the server
docs
*.md
**/*.test.ts
**/*.test.tsx
vitest.config.ts

# Editor and OS noise
.DS_Store
.vscode
.idea
*.log
*.tsbuildinfo

# Docker artifacts themselves
Dockerfile
.dockerignore
docker-compose.yml
Jenkinsfile
